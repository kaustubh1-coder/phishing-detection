# ==============================================================================
# Network Security Phishing URL Detection - Environment Configuration
# Use this template for setting environment variables on Render (Backend)
# ==============================================================================

# MongoDB Connection String (Required for users, history, and training data)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL_KEY=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# MongoDB Database & Collection Names
DATA_INGESTION_DATABASE_NAME=MyPhishingDetection
DATA_INGESTION_COLLECTION_NAME=MyNetworkData
URL_PREDICTION_COLLECTION_NAME=url_prediction_history
AUTH_USER_COLLECTION_NAME=users
AUTH_SESSION_COLLECTION_NAME=user_sessions
AUTH_SESSION_DAYS=7

# Google Gemini API Key (Optional: for evidence-grounded AI explanations; falls back to local SHAP summary if omitted)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=5.0

# CORS Allowed Origins (Comma-separated list or *; all https://*.vercel.app are automatically allowed)
CORS_ORIGINS=*

# DagsHub / MLflow Tracking (Optional)
DAGSHUB_REPO_OWNER=Sahilpatil009
DAGSHUB_REPO_NAME=network-security-edi
DAGSHUB_USER_TOKEN=
